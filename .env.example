# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tuktuk_tracker?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000

# JWT (use `openssl rand -hex 32`; the server refuses to start in production with a short secret)
JWT_SECRET=change_me_to_at_least_32_random_characters
JWT_EXPIRES_IN=8h

# CORS (set to your client origin in production)
CORS_ORIGIN=*

# Tracking behaviour
SPEED_LIMIT_KMH=60
ONLINE_THRESHOLD_MINUTES=10
PING_TTL_DAYS=365
RATE_LIMIT_PINGS_PER_MIN=60

# Seed / simulator
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
API_URL=http://localhost:3000
